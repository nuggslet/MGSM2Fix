+/* USA 0x800C7BD0: place the nine cursor pieces around a w x h box at (x, y),
+   screen-centred coordinates, and make them all visible in one colour.
+   USA only ever calls this with mode 1. */
+static void abst_cursor_frame(Work *work, int x, int y, int w, int h, int rgb, int mode)
+{
+    POLY_FT4 *poly;
+    int       i;
+    int       x0, y0, x1, y1, x2, y2, x3, y3;
+
+    poly = work->polys2;
+    for (i = 0; i < 9; i++)
+    {
+        work->attrs2[i] = 0x200;
+        setRGB0(poly, rgb, rgb, rgb);
+        poly++;
+    }
+
+    if (mode == 0)
+    {
+        x0 = x - 8;
+        y0 = y - 8;
+        x1 = x;
+        y1 = y;
+        x2 = x + w;
+        y2 = y + h;
+        x3 = x + w + 8;
+        y3 = y + h + 8;
+    }
+    else if (mode == 1)
+    {
+        x0 = x - 6;
+        y0 = y - 6;
+        x1 = x + 2;
+        y1 = y + 2;
+        x2 = x + w - 2;
+        y2 = y + h - 2;
+        x3 = x + w + 6;
+        y3 = y + h + 6;
+    }
+    else
+    {
+        return;
+    }
+
+    poly = work->polys2;
+    setXY4(&poly[0], x0, y0, x1, y0, x0, y1, x1, y1);   /* cur_lu */
+    setXY4(&poly[1], x2, y0, x3, y0, x2, y1, x3, y1);   /* cur_ru */
+    setXY4(&poly[2], x0, y2, x1, y2, x0, y3, x1, y3);   /* cur_ld */
+    setXY4(&poly[3], x2, y2, x3, y2, x2, y3, x3, y3);   /* cur_rd */
+    setXY4(&poly[4], x1, y0, x2, y0, x1, y1, x2, y1);   /* cur_u */
+    setXY4(&poly[5], x1, y2, x2, y2, x1, y3, x2, y3);   /* cur_d */
+    setXY4(&poly[6], x0, y1, x1, y1, x0, y2, x1, y2);   /* cur_l */
+    setXY4(&poly[7], x2, y1, x3, y1, x2, y2, x3, y2);   /* cur_r */
+    setXY4(&poly[8], x1, y1, x2, y1, x1, y2, x2, y2);   /* cur_c */
+}
+
+/* USA 0x800C7FC0: "1/2" in the menu font under the text panel; the total is
+   USA's literal 2. Fades with the frame counter while the log closes. */
+static void abst_draw_page_counter(Work *work)
+{
+    int r, g, b;
+
+    if (work->field_1D64 == 3)
+    {
+        r = 86 - (work->field_1D5C * 86) / 8;
+        g = 137 - (work->field_1D5C * 137) / 8;
+        b = 116 - (work->field_1D5C * 116) / 8;
+    }
+    else
+    {
+        r = 86;
+        g = 137;
+        b = 116;
+    }
+
+    MENU_Locate(145, 202, 0x10);
+    MENU_Color(r, g, b);
+    MENU_Printf("%d", work->page);
+
+    MENU_Locate(156, 202, 0x10);
+    MENU_Color(r, g, b);
+    MENU_Printf("/");
+
+    MENU_Locate(167, 202, 0x10);
+    MENU_Color(r, g, b);
+    MENU_Printf("%d", 2);
+}
+
+/* the lines of the current page are records base+1 .. base+7. USA colours
+   them unguarded; a page with count 7 has no second-screen KCBs, and
+   font_set_color on an unallocated KCB writes through a NULL CLUT buffer, so
+   stop at the last record the page actually has. */
+static void abst_color_page(Work *work, int base, int col)
+{
+    int i;
+
+    for (i = base + 1; i < base + ABST_LINES_PER_PAGE + 1; i++)
+    {
+        if (i > work->field_2C4)
+        {
+            break;
+        }
