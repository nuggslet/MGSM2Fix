+/* USA: turning to the next page - the cursor lands on EXIT (or, from EXIT
+   with R1, on the previous arrow), the previous arrow appears, the next one
+   goes */
+static void abst_turn_forward(Work *work, int cursor)
+{
+    GM_SeSet2(0, 63, SE_ABST_PAGE);
+    work->field_1D64 = 4;
+    work->cursor = cursor;
+    if (cursor == 2)
+    {
+        abst_cursor_frame(work, 90, 87, 54, 12, 255, 1);
+    }
+    else
+    {
+        abst_cursor_frame(work, -46, 86, 16, 14, 255, 1);
+    }
+    work->field_1D5C = 0;
+    work->attrs1[4] = 0x100;
+    work->attrs1[5] = 0;
+}
+
+/* USA: turning back - the cursor lands on the next arrow, which reappears */
+static void abst_turn_back(Work *work)
+{
+    GM_SeSet2(0, 63, SE_ABST_PAGE);
+    work->field_1D64 = 5;
+    work->cursor = 1;
+    abst_cursor_frame(work, 30, 86, 16, 14, 255, 1);
+    work->field_1D5C = 0;
+    work->attrs1[4] = 0;
+    work->attrs1[5] = 0x100;
+}
+
+static void abst_leave(Work *work)
+{
+    GM_SeSet2(0, 63, SE_MENU_EXIT);
+    work->field_1D64 = 3;
+    work->field_1D5C = 0;
+}
